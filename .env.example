# ---- Backend ----------------------------------------------------------------
# sdk | cli | auto  (auto prefers the Agent SDK, falls back to `claude -p`)
CLAUDE_BACKEND=auto
# Explicit path to the `claude` binary (optional; SDK uses its bundled CLI).
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
# Default model for every request (Opus 4.8). Use 'opus' to track latest Opus,
# or blank for Claude Code's own default.
DEFAULT_MODEL=claude-opus-4-8
# Permission mode for agent/code endpoints (no human is at the HTTP end).
# 'auto' = a classifier approves/denies each tool call so runs proceed smoothly.
# 'bypassPermissions' = allow everything unconditionally.
DEFAULT_PERMISSION_MODE=auto
# 0 = unlimited turns (bounded only by your Claude Code plan).
MAX_TURNS=0
# Leave unset for no per-run USD ceiling.
# MAX_BUDGET_USD=
# High by default — Claude Code can take a while. 0 = never time out.
JOB_TIMEOUT_S=3600
SESSION_IDLE_TTL_S=900

# ---- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
LOCALHOST_ONLY=1
ALLOW_REMOTE=0

# ---- Security ---------------------------------------------------------------
# Shared bearer secret. CHANGE THIS. Empty string disables auth (dev only).
API_KEY=changeme
# 0 = no rate limiting (default; single-user localhost). Set > 0 to throttle.
RATE_LIMIT_PER_MIN=0
RATE_LIMIT_BURST=30
CORS_ORIGINS=*

# ---- Storage ----------------------------------------------------------------
# GATEWAY_HOME=~/.claude_gateway
# DB_PATH=~/.claude_gateway/gateway.db
# WORKSPACES_DIR=~/.claude_gateway/workspaces

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=0
OTEL_ENABLED=0
# OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=claude-gateway
